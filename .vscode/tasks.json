{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cài đặt thư viện Frontend (Tự động kiểm tra)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/run-frontend.mjs", "ensure-deps"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chạy Frontend (Vite - Cổng 5173)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/run-frontend.mjs", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Chạy Backend (Spring Boot - Cổng 8080)",
      "type": "shell",
      "command": "mvn",
      "args": ["spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}/backend-springboot"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Kiểm thử Frontend (Vitest)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/run-frontend.mjs", "test", "--", "--run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Kiểm thử Backend (Maven Unit Tests)",
      "type": "shell",
      "command": "mvn",
      "args": ["test", "-Dtest=!*IntegrationTest*,!DavsApplicationTests"],
      "options": {
        "cwd": "${workspaceFolder}/backend-springboot"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
