# ============================================================================
# DAVS – Environment Configuration Example (infra/.env.example)
# Copy this file to infra/.env and adjust values for your environment.
# NEVER commit real secrets to version control.
# ============================================================================

# --- Application ---
APP_NAME=DAVS
APP_BASE_URL=http://localhost:3000
SPRING_PROFILES_ACTIVE=default

# --- PostgreSQL 16 ---
POSTGRES_DB=davs
DB_URL=jdbc:postgresql://postgres:5432/davs
DB_USER=davs
DB_PASSWORD=davs_secret_password_change_me

# --- MinIO (S3-compatible Object Storage) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=davs_minio_admin
MINIO_SECRET_KEY=davs_minio_secret_change_me

# --- Security & Cryptography ---
# JWT secret key (minimum 32 bytes / 256 bits, base64 encoded)
JWT_SECRET=ZGF2cy1kZXYtand0LXNlY3JldC1rZXktbXVzdC1iZS1hdC1sZWFzdC0zMi1ieXRlcy1sb25n
# AES-256-GCM encryption key for data source & integration secrets (exact 32 bytes, base64 encoded)
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Initial Site Admin Seed (T-011) ---
ADMIN_EMAIL=admin@davs.local
ADMIN_INITIAL_PASSWORD=Admin@123456!ChangeMe

# --- SMTP / Email (MailHog in dev) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@davs.local
