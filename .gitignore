# ============================================================================
# DAVS Monorepo - .gitignore
# ============================================================================

# --- Environment & Secrets (NEVER commit real secrets) ---
.env
.env.*
!.env.example
infra/.env
infra/.env.*
!infra/.env.example
*.pem
*.key
*.p12
*.jks

# --- Backend (Java / Maven / Spring Boot) ---
**/target/
backend/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- Frontend (Node / Vite / React / Playwright) ---
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Docker / Volumes ---
infra/pgdata/
infra/miniodata/

# --- IDEs & Editors ---
.idea/
*.iws
*.iml
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.project
.classpath
.settings/
.factorypath
*.swp
*.swo
*~

# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
